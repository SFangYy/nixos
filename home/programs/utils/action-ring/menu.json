        "icon": "keyboard",
        "iconTheme": "material-symbols-rounded",
        "children": [
          {
            "type": "button",
            "name": "原有 Meta+Shift 宏",
            "icon": "macro-item.svg",
            "iconTheme": "kando",
            "selectWorkflow": {
              "actions": [
                {
                  "type": "close-menu"
                },
                {
                  "type": "execute-macro",
                  "macro": [
                    {
                      "type": "keyDown",
                      "key": "MetaLeft",
                      "delay": 10
                    },
                    {
                      "type": "keyDown",
                      "key": "ShiftLeft",
                      "delay": 10
                    },
                    {
                      "type": "keyUp",
                      "key": "MetaLeft",
                      "delay": 10
                    },
                    {
                      "type": "keyUp",
                      "key": "ShiftLeft",
                      "delay": 10
                    }
                  ]
                }
              ],
              "quickSelectKey": "M"
            }
          },
          {
            "type": "button",
            "name": "粘贴 RoleInfo 提示词",
            "icon": "text-item.svg",
            "iconTheme": "kando",
            "selectWorkflow": {
              "quickSelectKey": "P",
              "actions": [
                {
                  "type": "inhibit-shortcuts"
                },
                {
                  "type": "close-menu"
                },
                {
                  "type": "set-clipboard",
                  "text": "请通过工具RoleInfo获取你的角色信息和基本指导，然后完成任务。请使用工具ReadTextFile读取文件。你需要在当前工作目录进行文件操作，不要超出该目录。"
                },
                {
                  "type": "simulate-hotkey",
                  "hotkey": "ControlLeft+KeyV"
                }
              ]
            }
          }
